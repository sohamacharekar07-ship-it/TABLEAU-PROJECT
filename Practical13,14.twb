      <aliases enabled='yes' />
      <column caption='Profit Ratio' datatype='real' default-format='p0.00%' name='[Calculation_1589670034026496]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Country' datatype='string' name='[Calculation_1589670035726337]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='&quot;India&quot;' />
      </column>
      <column caption='Recency Days' datatype='integer' name='[Calculation_1589670039695362]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='DATEDIFF(&#13;&#10;    &apos;day&apos;,&#13;&#10;    { FIXED [Customer ID] : MAX([Order Date]) },&#13;&#10;    { FIXED : MAX([Order Date]) }&#13;&#10;)' />
      </column>
      <column caption='Frequency' datatype='integer' name='[Calculation_1589670039916547]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : COUNTD([Order ID]) }' />
      </column>
      <column caption='Monetary Value' datatype='real' name='[Calculation_1589670040629252]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Customer ID] : SUM([Sales]) }' />
      </column>
      <column caption='Customer Value Segment' datatype='string' name='[Calculation_1589670051414021]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1589670040629252] &gt;= 20000&#13;&#10;AND [Calculation_1589670039916547] &gt;= 3&#13;&#10;AND [Calculation_1589670039695362] &lt;= 180&#13;&#10;THEN &quot;High-Value Customer&quot;&#13;&#10;ELSE &quot;Other Customers&quot;&#13;&#10;END' />
      </column>
